{
    "profiles": [
        {
            "complex_modifications": {
                "rules": [
                    {
                        "description": "Zen Browser: Ctrl+J/K to switch tabs",
                        "manipulators": [
                            {
                                "conditions": [
                                    {
                                        "bundle_identifiers": [
                                            "^app\\.zen-browser\\.zen$"
                                        ],
                                        "type": "frontmost_application_if"
                                    }
                                ],
                                "from": {
                                    "key_code": "j",
                                    "modifiers": {
                                        "mandatory": ["control"],
                                        "optional": []
                                    }
                                },
                                "to": [
                                    {
                                        "key_code": "tab",
                                        "modifiers": ["left_control"]
                                    }
                                ],
                                "type": "basic"
                            },
                            {
                                "conditions": [
                                    {
                                        "bundle_identifiers": [
                                            "^app\\.zen-browser\\.zen$"
                                        ],
                                        "type": "frontmost_application_if"
                                    }
                                ],
                                "from": {
                                    "key_code": "k",
                                    "modifiers": {
                                        "mandatory": ["control"],
                                        "optional": []
                                    }
                                },
                                "to": [
                                    {
                                        "key_code": "tab",
                                        "modifiers": ["left_control", "left_shift"]
                                    }
                                ],
                                "type": "basic"
                            }
                        ]
                    },
                    {
                        "description": "Double tap Left Control -> Russian PC / ABC (direct, standalone taps only)",
                        "manipulators": [
                            {
                                "type": "basic",
                                "from": {
                                    "key_code": "left_control",
                                    "modifiers": { "optional": ["caps_lock"] }
                                },
                                "to": [
                                    {
                                        "set_variable": {
                                            "name": "left_control_double_tap_pending",
                                            "value": false
                                        }
                                    },
                                    { "key_code": "left_control" }
                                ],
                                "parameters": { "basic.to_if_alone_timeout_milliseconds": 300 },
                                "conditions": [
                                    {
                                        "type": "variable_if",
                                        "name": "left_control_double_tap_pending",
                                        "value": true
                                    },
                                    {
                                        "type": "input_source_if",
                                        "input_sources": [{ "input_source_id": "^com\\.apple\\.keylayout\\.RussianWin$" }]
                                    }
                                ],
                                "to_if_alone": [{ "select_input_source": { "input_source_id": "^com\\.apple\\.keylayout\\.ABC$" } }]
                            },
                            {
                                "type": "basic",
                                "from": {
                                    "key_code": "left_control",
                                    "modifiers": { "optional": ["caps_lock"] }
                                },
                                "to": [
                                    {
                                        "set_variable": {
                                            "name": "left_control_double_tap_pending",
                                            "value": false
                                        }
                                    },
                                    { "key_code": "left_control" }
                                ],
                                "parameters": { "basic.to_if_alone_timeout_milliseconds": 300 },
                                "conditions": [
                                    {
                                        "type": "variable_if",
                                        "name": "left_control_double_tap_pending",
                                        "value": true
                                    },
                                    {
                                        "type": "input_source_if",
                                        "input_sources": [{ "input_source_id": "^com\\.apple\\.keylayout\\.ABC$" }]
                                    }
                                ],
                                "to_if_alone": [{ "select_input_source": { "input_source_id": "^com\\.apple\\.keylayout\\.RussianWin$" } }]
                            },
                            {
                                "type": "basic",
                                "from": {
                                    "key_code": "left_control",
                                    "modifiers": { "optional": ["caps_lock"] }
                                },
                                "to": [{ "key_code": "left_control" }],
                                "to_if_alone": [
                                    {
                                        "set_variable": {
                                            "name": "left_control_double_tap_pending",
                                            "value": true
                                        }
                                    }
                                ],
                                "to_delayed_action": {
                                    "to_if_invoked": [
                                        {
                                            "set_variable": {
                                                "name": "left_control_double_tap_pending",
                                                "value": false
                                            }
                                        }
                                    ],
                                    "to_if_canceled": [
                                        {
                                            "set_variable": {
                                                "name": "left_control_double_tap_pending",
                                                "value": false
                                            }
                                        }
                                    ]
                                },
                                "parameters": {
                                    "basic.to_if_alone_timeout_milliseconds": 300,
                                    "basic.to_delayed_action_delay_milliseconds": 400
                                }
                            }
                        ]
                    },
                    {
                        "description": "Double tap Left Shift -> Cmd Shift Space",
                        "manipulators": [
                            {
                                "conditions": [
                                    {
                                        "expression": "left_shift_x2_expiration > system.now.milliseconds",
                                        "type": "expression_if"
                                    }
                                ],
                                "from": {
                                    "key_code": "left_shift",
                                    "modifiers": { "optional": ["any"] }
                                },
                                "to": [
                                    {
                                        "set_variable": {
                                            "name": "left_shift_x2_expiration",
                                            "value": 0
                                        }
                                    },
                                    {
                                        "key_code": "spacebar",
                                        "modifiers": ["left_command", "left_shift"]
                                    },
                                    { "key_code": "vk_none" }
                                ],
                                "type": "basic"
                            },
                            {
                                "from": {
                                    "key_code": "left_shift",
                                    "modifiers": { "optional": ["any"] }
                                },
                                "to": [
                                    {
                                        "set_variable": {
                                            "expression": "system.now.milliseconds + 300",
                                            "name": "left_shift_x2_expiration"
                                        }
                                    },
                                    { "key_code": "left_shift" }
                                ],
                                "type": "basic"
                            }
                        ]
                    }
                ]
            },
            "devices": [
                {
                    "identifiers": {
                        "is_keyboard": true,
                        "is_pointing_device": true,
                        "product_id": 12292,
                        "vendor_id": 14000
                    },
                    "ignore": false,
                    "manipulate_caps_lock_led": false,
                    "simple_modifications": [
                        {
                            "from": { "key_code": "left_command" },
                            "to": [{ "key_code": "left_option" }]
                        },
                        {
                            "from": { "key_code": "left_control" },
                            "to": [{ "apple_vendor_top_case_key_code": "keyboard_fn" }]
                        },
                        {
                            "from": { "key_code": "left_option" },
                            "to": [{ "key_code": "left_command" }]
                        }
                    ]
                },
                {
                    "identifiers": { "is_keyboard": true },
                    "simple_modifications": [
                        {
                            "from": { "key_code": "caps_lock" },
                            "to": [{ "key_code": "left_control" }]
                        }
                    ]
                }
            ],
            "name": "Default profile",
            "selected": true,
            "virtual_hid_keyboard": { "keyboard_type_v2": "ansi" }
        }
    ]
}