{
    "title": "Zen Browser: Ctrl+J/K to switch tabs",
    "rules": [
        {
            "description": "Zen Browser: Ctrl+J/K to switch tabs",
            "manipulators": [
                {
                    "conditions": [
                        {
                            "bundle_identifiers": [
                                "^app\\.zen-browser\\.zen$"
                            ],
                            "type": "frontmost_application_if"
                        }
                    ],
                    "from": {
                        "key_code": "j",
                        "modifiers": {
                            "mandatory": ["control"],
                            "optional": []
                        }
                    },
                    "to": [
                        {
                            "key_code": "tab",
                            "modifiers": ["left_control"]
                        }
                    ],
                    "type": "basic"
                },
                {
                    "conditions": [
                        {
                            "bundle_identifiers": [
                                "^app\\.zen-browser\\.zen$"
                            ],
                            "type": "frontmost_application_if"
                        }
                    ],
                    "from": {
                        "key_code": "k",
                        "modifiers": {
                            "mandatory": ["control"],
                            "optional": []
                        }
                    },
                    "to": [
                        {
                            "key_code": "tab",
                            "modifiers": ["left_control", "left_shift"]
                        }
                    ],
                    "type": "basic"
                }
            ]
        }
    ]
}