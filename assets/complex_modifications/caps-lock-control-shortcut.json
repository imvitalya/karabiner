{
    "title": "Caps Lock -> Left Control + Double tap -> Control Shift Space (MacBook only)",
    "rules": [
        {
            "description": "Caps Lock -> Left Control + Double tap -> Control Shift Space (MacBook only)",
            "manipulators": [
                {
                    "conditions": [
                        {
                            "identifiers": [{ "is_built_in_keyboard": true }],
                            "type": "device_if"
                        },
                        {
                            "expression": "caps_lock_x2_expiration > system.now.milliseconds",
                            "type": "expression_if"
                        }
                    ],
                    "from": {
                        "key_code": "caps_lock",
                        "modifiers": { "optional": ["any"] }
                    },
                    "to": [
                        {
                            "set_variable": {
                                "name": "caps_lock_x2_expiration",
                                "value": 0
                            }
                        },
                        {
                            "key_code": "spacebar",
                            "modifiers": ["left_control", "left_shift"]
                        },
                        { "key_code": "vk_none" }
                    ],
                    "type": "basic"
                },
                {
                    "conditions": [
                        {
                            "identifiers": [{ "is_built_in_keyboard": true }],
                            "type": "device_if"
                        }
                    ],
                    "from": {
                        "key_code": "caps_lock",
                        "modifiers": { "optional": ["any"] }
                    },
                    "to": [
                        {
                            "set_variable": {
                                "expression": "system.now.milliseconds + 300",
                                "name": "caps_lock_x2_expiration"
                            }
                        },
                        { "key_code": "left_control" }
                    ],
                    "type": "basic"
                }
            ]
        }
    ]
}